<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>xyz.wewin.autumn</groupId>
		<artifactId>autumn-gateway</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>autumn-gateway-deploy</artifactId>
	<name>autumn-gateway-deploy</name>
	<description>最终网关发行包：按 profile 选择组件，统一在此做 GraalVM native 构建</description>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
		<start-class>xyz.wewin.autumn.gateway.AutumnGatewayApplication</start-class>
		<!-- 目标平台后缀，由 -Pos-* profile 覆盖；产物名形如 autumn-gateway-linux-amd64 -->
		<image.suffix>-linux-amd64</image.suffix>
	</properties>
	<dependencies>
		<!-- Spring Cloud Gateway -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>joda-time</groupId>
			<artifactId>joda-time</artifactId>
			<version>2.12.7</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.graalvm.buildtools</groupId>
				<artifactId>native-maven-plugin</artifactId>
				<configuration>
					<imageName>${project.artifactId}${image.suffix}</imageName>
					<mainClass>${start-class}</mainClass>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- ============================================================
		     组件编排：用 -Pcomponent-xxx 决定最终网关里装了哪些能力。
		     默认开轻量 authz（JWT + 路由级 FilterFactory）；OAuth2 单点方式仍保留为可选 profile。
		     全部关闭即为「纯路由网关」。
		     这就是后续「表单勾选组件 → 生成 pom → 统一构建」的落点。

		     例：默认轻量 JWT 登录 + 路由级鉴权
		       mvn ...
		     例：OAuth2 单点认证（不用轻量 authz）
		       mvn -Pcomponent-authn -Dno.authz ...
		     例：轻量 authz + 限流
		       mvn -Pcomponent-limit ...
		     例：只装限流，不装任何认证
		       mvn -Pcomponent-limit -Dno.authz ...

		     ⚠️ Maven 坑：只要在命令行显式写了任何一个 -P，所有 activeByDefault
		     的 profile 都会被关闭。默认组件因此用「属性不存在则激活」（!no.authz）
		     而不是 activeByDefault；其余组件均为显式 profile。
		     ============================================================ -->
		<profile>
			<id>component-authn</id>
			<dependencies>
				<dependency>
					<groupId>xyz.wewin.autumn</groupId>
					<artifactId>authn-autumn-gateway-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<!--
			轻量认证 + 路由级鉴权：默认装配；用 -Dno.authz 关闭。
			MySQL 驱动放在最终发行包而不是 starter 中，starter 本身只依赖 DataSource。
		-->
		<profile>
			<id>component-authz</id>
			<activation>
				<property>
					<name>!no.authz</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>xyz.wewin.autumn</groupId>
					<artifactId>authz-autumn-gateway-starter</artifactId>
				</dependency>
				<dependency>
					<groupId>com.mysql</groupId>
					<artifactId>mysql-connector-j</artifactId>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>

		<profile>
			<id>component-limit</id>
			<dependencies>
				<dependency>
					<groupId>xyz.wewin.autumn</groupId>
					<artifactId>limit-autumn-gateway-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<profile>
			<id>component-discovery</id>
			<dependencies>
				<dependency>
					<groupId>xyz.wewin.autumn</groupId>
					<artifactId>config-discovery-autumn-gateway-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<!-- ============================================================
		     目标操作系统。GraalVM 不做交叉编译：要出哪个平台的二进制，
		     就得在哪个平台上构建（或用对应架构的 GraalVM 容器 + qemu 模拟）。

		     这里用 activeByDefault 是安全的：即使它被 -P 关掉，
		     <properties> 里的 image.suffix 默认值（-linux-amd64）仍然生效。
		     ============================================================ -->
		<profile>
			<id>os-linux</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<image.suffix>-linux-amd64</image.suffix>
			</properties>
		</profile>

		<profile>
			<id>os-linux-arm</id>
			<properties>
				<image.suffix>-linux-arm64</image.suffix>
			</properties>
		</profile>

		<profile>
			<id>os-windows</id>
			<properties>
				<image.suffix>-windows-amd64.exe</image.suffix>
			</properties>
		</profile>
	</profiles>

</project>
