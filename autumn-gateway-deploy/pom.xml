<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>xyz.we-win.autumn</groupId>
		<artifactId>autumn-gateway</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>autumn-gateway-deploy</artifactId>
	<name>autumn-gateway-deploy</name>
	<description>最终网关发行包：按 profile 选择组件，统一在此做 GraalVM native 构建</description>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
		<start-class>xyz.wewin.autumn.gateway.AutumnGatewayApplication</start-class>
		<!-- 目标平台后缀，由 -Pos-* profile 覆盖；产物名形如 autumn-gateway-linux-amd64 -->
		<image.suffix>-linux-amd64</image.suffix>
		<!-- Bucket4j 不在 spring-boot / cloud / gateway 任何 BOM 里，必须自己锁版本；
		     8.15.0 与 Gateway 5.0.3 内部构建版本一致（CaffeineProxyManager 构造器在 8.21+ 才废弃） -->
		<bucket4j-jdk17.version>8.15.0</bucket4j-jdk17.version>
	</properties>
	<dependencies>
		<!-- Spring Cloud Gateway -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>joda-time</groupId>
			<artifactId>joda-time</artifactId>
			<version>2.12.7</version>
		</dependency>

		<!-- ============================================================
		     运行时数据库驱动：三个都带上，让「一个二进制 + 运行时 spring.profiles.active=db-*」
		     就能切库，不用重新构建、也不用再引入一层 Maven profile。
		     驱动走 SPI 注册，未使用的会被 AOT 裁剪，对 native 产物体积影响可忽略。
		     ============================================================ -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ============================================================
		     官方 RequestRateLimiter 的内存实现依赖。
		     仅在 autumn.limit.enabled=true 时才注册 AsyncProxyManager / KeyResolver bean，
		     默认不生效，因此不影响现有发行形态。示例见 feature/limit/。
		     ============================================================ -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j_jdk17-caffeine</artifactId>
			<version>${bucket4j-jdk17.version}</version>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.graalvm.buildtools</groupId>
				<artifactId>native-maven-plugin</artifactId>
				<configuration>
					<imageName>${project.artifactId}${image.suffix}</imageName>
					<mainClass>${start-class}</mainClass>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- ============================================================
		     组件编排：用 -Pcomponent-xxx 决定最终网关里装了哪些能力。
		     默认开轻量 authz（JWT + 路由级 FilterFactory）；OAuth2 单点方式仍保留为可选 profile。
		     全部关闭即为「纯路由网关」。
		     这就是后续「表单勾选组件 → 生成 pom → 统一构建」的落点。

		     例：默认轻量 JWT 登录 + 路由级鉴权
		       mvn ...
		     例：OAuth2 单点认证（不用轻量 authz）
		       mvn -Pcomponent-authn -Dno.authz ...
⚠️ Maven 坑：只要在命令行显式写了任何一个 -P，所有 activeByDefault
		     的 profile 都会被关闭。默认组件因此用「属性不存在则激活」（!no.authz）
		     而不是 activeByDefault；其余组件均为显式 profile。
		     ============================================================ -->
		<profile>
			<id>component-authn</id>
			<dependencies>
				<dependency>
					<groupId>xyz.we-win.autumn</groupId>
					<artifactId>authn-autumn-gateway-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<!--
			轻量认证 + 路由级鉴权：默认装配；用 -Dno.authz 关闭。
			starter 本身只依赖 DataSource；三种 DB 驱动统一放在主 dependencies，
			这样 -Pcomponent-authn -Dno.authz（OAuth2 版）与 db-* 运行时 profile 互不干扰。
		-->
		<profile>
			<id>component-authz</id>
			<activation>
				<property>
					<name>!no.authz</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>xyz.we-win.autumn</groupId>
					<artifactId>authz-autumn-gateway-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<!-- ============================================================
		     服务发现（三选一）：autumn-cloud-extension discovery starter。
		     三种后端互斥；只引一个时可以省略 autumn.discovery.backend，
		     同时引多个则必须显式指定，否则启动期 BackendValidator 直接失败。
		       -Pcomponent-discovery            Consul HTTP API（默认推荐，无 SDK）
		       -Pcomponent-discovery-nacos      Nacos OpenAPI v1
		       -Pcomponent-discovery-multicast  UDP 组播，零外部依赖，本地开发用
		     ============================================================ -->
		<profile>
			<id>component-discovery</id>
			<dependencies>
				<dependency>
					<groupId>xyz.we-win.autumn</groupId>
					<artifactId>autumn-cloud-extension-discovery-consul-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<profile>
			<id>component-discovery-nacos</id>
			<dependencies>
				<dependency>
					<groupId>xyz.we-win.autumn</groupId>
					<artifactId>autumn-cloud-extension-discovery-nacos-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<profile>
			<id>component-discovery-multicast</id>
			<dependencies>
				<dependency>
					<groupId>xyz.we-win.autumn</groupId>
					<artifactId>autumn-cloud-extension-discovery-multicast-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<!-- ============================================================
		     配置中心（可选，二选一）：启动期注入远程 PropertySource，
		     变更时原地刷新并触发 ContextRefresher。
		     必须显式设置 autumn.config.backend 才启用，否则只打 WARN 不装配。
		       -Pcomponent-config         Consul KV（blocking query）
		       -Pcomponent-config-nacos   Nacos 长轮询（真实 MD5）
		     ============================================================ -->
		<profile>
			<id>component-config</id>
			<dependencies>
				<dependency>
					<groupId>xyz.we-win.autumn</groupId>
					<artifactId>autumn-cloud-extension-config-consul-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<profile>
			<id>component-config-nacos</id>
			<dependencies>
				<dependency>
					<groupId>xyz.we-win.autumn</groupId>
					<artifactId>autumn-cloud-extension-config-nacos-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<!-- ============================================================
		     泳道路由（可选）：按 X-Traffic 把请求打到同标签实例，
		     未打标/未带头归入 default 主干，目标标签无实例时回落主干或 503。
		     依赖 LoadBalancer（lb:// 路由）与服务发现，所以单独开它没有意义，
		     实际组合示例：-Pcomponent-discovery,component-traffic
		     ============================================================ -->
		<profile>
			<id>component-traffic</id>
			<dependencies>
				<dependency>
					<groupId>xyz.we-win.autumn</groupId>
					<artifactId>autumn-cloud-extension-traffic-starter</artifactId>
				</dependency>
			</dependencies>
		</profile>

		<!-- ============================================================
		     目标操作系统。GraalVM 不做交叉编译：要出哪个平台的二进制，
		     就得在哪个平台上构建（或用对应架构的 GraalVM 容器 + qemu 模拟）。

		     这里用 activeByDefault 是安全的：即使它被 -P 关掉，
		     <properties> 里的 image.suffix 默认值（-linux-amd64）仍然生效。
		     ============================================================ -->
		<profile>
			<id>os-linux</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<image.suffix>-linux-amd64</image.suffix>
			</properties>
		</profile>

		<profile>
			<id>os-linux-arm</id>
			<properties>
				<image.suffix>-linux-arm64</image.suffix>
			</properties>
		</profile>

		<profile>
			<id>os-windows</id>
			<properties>
				<image.suffix>-windows-amd64.exe</image.suffix>
			</properties>
		</profile>
	</profiles>

</project>
