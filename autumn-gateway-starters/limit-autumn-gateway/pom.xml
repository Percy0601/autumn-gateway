<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>xyz.wewin.autumn</groupId>
        <artifactId>autumn-gateway-starters</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>limit-autumn-gateway</artifactId>
    <name>limit-autumn-gateway</name>
    <description>基于内存（Bucket4j）的网关限流过滤器核心库</description>

    <dependencies>
        <!-- 网关 API：仅编译期需要，运行时由最终应用提供 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 单机内存限流：Gateway 5.x 官方定的算法 -->
        <dependency>
            <groupId>com.github.vladimir-bukhtoyarov</groupId>
            <artifactId>bucket4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.wewin.autumn</groupId>
            <artifactId>autumn-gateway-common</artifactId>
        </dependency>
    </dependencies>
</project>
