{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "esnext",
		"useDefineForClassFields": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "preserve",
		"skipLibCheck": true,
		"allowJs": true,
		"sourceMap": true,
		// 关键：禁止 tsc/vue-tsc 把编译产物（.js/.js.map）吐进 src/。
		// 历史上这些产物与同名 .ts 并存，Vite 的 resolve.extensions 中 .js 优先于 .ts，
		// 导致运行时加载到过期模块，出现「登录后首页空白」。
		"noEmit": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"lib": ["esnext", "dom"],
		"types": ["web-bluetooth", "vite/client"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
	"exclude": ["node_modules"]
}
