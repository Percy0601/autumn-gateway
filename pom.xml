<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>xyz.wewin.autumn</groupId>
	<artifactId>autumn-gateway</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<modules>
		<module>autumn-gateway-deploy</module>
		<module>autumn-gateway-discovery</module>
		<module>autumn-gateway-examples</module>
		<module>autumn-gateway-dashboard</module>
		<module>autumn-gateway-starters</module>
        <module>autumn-gateway-common</module>
        <module>autumn-gateway-authorization</module>
	</modules>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
		<spring-cloud.version>2025.1.3</spring-cloud.version>
		<jjwt-api.version>0.13.0</jjwt-api.version>
		<maven.compiler.source>25</maven.compiler.source>
		<maven.compiler.target>25</maven.compiler.target>
		<lombok.version>1.18.48</lombok.version>
        <bucket4j-core.version>8.0.1</bucket4j-core.version>
        <caffeine.version>3.2.4</caffeine.version>
		<mybatis-spring-boot-starter.version>4.1.0</mybatis-spring-boot-starter.version>
		<spring-boot-starter-security-oauth2-authorization-server.version>4.1.1</spring-boot-starter-security-oauth2-authorization-server.version>
        <spring-cloud-starter-gateway-server-webflux.version>5.0.3</spring-cloud-starter-gateway-server-webflux.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
            <dependency>
                <groupId>com.github.vladimir-bukhtoyarov</groupId>
                <artifactId>bucket4j-core</artifactId>
                <version>${bucket4j-core.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-api</artifactId>
				<version>${jjwt-api.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-impl</artifactId>
				<version>${jjwt-api.version}</version>
				<scope>runtime</scope>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-jackson</artifactId>
				<version>${jjwt-api.version}</version>
				<scope>runtime</scope>
			</dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
                <version>${spring-cloud-starter-gateway-server-webflux.version}</version>
			</dependency>
            <dependency>
                <groupId>xyz.wewin.autumn</groupId>
                <artifactId>autumn-gateway-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 网关可选组件 starter：由 autumn-gateway-deploy 用 -Pcomponent-* 选择装配 -->
            <dependency>
                <groupId>xyz.wewin.autumn</groupId>
                <artifactId>authn-autumn-gateway-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.wewin.autumn</groupId>
                <artifactId>authz-autumn-gateway-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.wewin.autumn</groupId>
                <artifactId>limit-autumn-gateway-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.wewin.autumn</groupId>
                <artifactId>config-discovery-autumn-gateway-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-actuator</artifactId>
				<!-- 砍掉 micrometer，省一大块 -->
				<exclusions>
					<exclusion>
						<groupId>io.micrometer</groupId>
						<artifactId>micrometer-core</artifactId>
					</exclusion>
					<exclusion>
						<groupId>io.micrometer</groupId>
						<artifactId>micrometer-observation</artifactId>
					</exclusion>
				</exclusions>
			</dependency>

            <!-- OAuth2 授权服务器：Boot 4 起 starter 更名为 spring-boot-starter-security-oauth2-authorization-server
                 （旧名 spring-boot-starter-oauth2-authorization-server 已废弃）；此处显式锁版本与 Boot 对齐 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-security-oauth2-authorization-server</artifactId>
                <version>${spring-boot-starter-security-oauth2-authorization-server.version}</version>
            </dependency>
		</dependencies>
	</dependencyManagement>

	<profiles>
		<!--
			GraalVM Native Image 构建（配合 spring-boot-starter-parent 内置的 native profile 一起激活）：

			  mvn -Pnative,native-image -pl autumn-gateway-dashboard package

			- native（parent 提供）：process-aot 执行 + native-maven-plugin 原始类路径配置
			  （classesDirectory=target/classes，绕过 repackage fat jar）+ reachability metadata 下载；
			- native-image（本仓库提供）：把 native:compile-no-fork 绑到 package 阶段，
			官方多模块项目定制 native profile 的标准做法（spring-boot-maven-plugin 文档 8.1.1）。
			注意用不同 id：同 id 会与 parent 的 native profile 发生继承合并，行为不确定。
			要求：JAVA_HOME 指向 GraalVM（native-image 25+），且模块已声明
			  org.graalvm.buildtools:native-maven-plugin（imageName/mainClass）。

			⚠️ 本 profile 会被所有模块继承（包括 pom 打包的父模块），所以
			native 构建**必须只针对单个模块**，不能加 -am：
			  ✗ mvn -Pnative,native-image -pl autumn-gateway-deploy -am package
			    → 父模块报 "Image classpath is empty"
			  ✓ mvn -B -pl autumn-gateway-deploy -am install -DskipTests   （先装依赖，不带 native）
			  ✓ mvn -B -Pnative,native-image -pl autumn-gateway-deploy package -DskipTests
		-->
		<profile>
			<id>native-image</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
