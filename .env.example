# 环境变量样例（只提交占位值，真实 .env 禁止入库）

# 复制本文件为 .env 后填入真实值：
#   cp .env.example .env
# .env 已加入 .gitignore。所有值都不要写进 application*.properties 或文档。

# ===== 所有发行形态必填 =====
# HS256 共享密钥，至少 32 字节。网关签发与 dashboard 验签必须是同一把。
# 生成示例：openssl rand -hex 32
AUTUMN_SHARED_JWT_SECRET=REPLACE_WITH_RANDOM_32_BYTES_OR_LONGER

# ===== db-mysql（默认）/ db-postgresql 必填；db-h2 不需要 =====
# 完整 JDBC URL，MySQL 示例：
# DB_URL=jdbc:mysql://DB_HOST:3306/autumn-security?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
# PostgreSQL 示例：
# DB_URL=jdbc:postgresql://DB_HOST:5432/autumn-security
DB_URL=REPLACE_WITH_JDBC_URL
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ===== 仅 OAuth2 SSO 配方需要 =====
AUTHN_CLIENT_SECRET=REPLACE_WITH_OAUTH2_CLIENT_SECRET

# ===== 可选：运行时数据库形态，默认 db-mysql =====
# 可选值：db-mysql / db-postgresql / db-h2（authorization 只有 db-mysql / db-h2）
# 旧名 mysql / postgresql / h2database 仍然有效（自动映射到对应 db-* profile）
SPRING_PROFILES_ACTIVE=db-mysql
